# AlphOne configuration. Copy to .env and fill in the values.
# Real environment variables take precedence over anything set here.

ALPHONE_DATABASE_URL=postgres://postgres:alphone@localhost:5433/postgres?sslmode=disable
# ALPHONE_ADDR=localhost:8080
# ALPHONE_WEB_DIR=

# Comma-separated CIDR ranges of reverse proxies allowed for login rate limiting.
# ALPHONE_TRUSTED_PROXIES=10.0.0.0/8

# How long a deactivated tenant keeps recording channel traffic, 336h when unset.
# ALPHONE_TENANT_MACHINE_GRACE=336h

# How many tenants' fields each server process keeps in memory, 256 when unset.
# ALPHONE_TENANTS_HELD=256
# How long a server process keeps a tenant's fields before reading them again, 1m when unset.
# ALPHONE_TENANTS_REFRESH=1m

# Rows a core graph list (contacts, tasks, contactPage) answers when the caller names none, 50 when unset.
# ALPHONE_GRAPH_PAGE_SIZE=50
# The most rows one core graph list (contacts, tasks, contactPage) answers, 200 when unset.
# At most 1250, the most rows a read of one field a row fits under the query cost limit of 2500.
# ALPHONE_GRAPH_PAGE_CAP=200

# How long a confirmation toast stays on screen, 6s when unset.
# A duration such as 6s or 1500ms, in whole milliseconds from 1ms to 2147483647ms.
# ALPHONE_TOAST_DURATION=6s
# The page sizes a list screen offers, 10,20,50,100 when unset.
# Each size once from the smallest up, none past the graph cap.
# ALPHONE_LIST_PAGE_SIZES=10,20,50,100
# The page size a list screen opens on, one of the sizes above, 20 when unset.
# ALPHONE_LIST_PAGE_SIZE=20
# The locale every screen writes dates, times, numbers and money in, whatever the interface language.
# A BCP 47 tag that names a language, es-ES when unset, which writes 30/09/2026, 09:05 and 1.234,56.
# ALPHONE_FORMAT_LOCALE=es-ES

# The most entries one repeater field holds on a contact, 500 when unset.
# ALPHONE_FIELDS_ENTRIES_MAX=500

# Any non-empty value serves the interactive GraphiQL page on GET /api/graphql.
# ALPHONE_DEV_GRAPHIQL=1

# Mail relay. Unset host runs without a mailer and invitations show
# their activation link for hand delivery instead.
# ALPHONE_SMTP_HOST=
# ALPHONE_SMTP_PORT=587
# ALPHONE_SMTP_USERNAME=
# ALPHONE_SMTP_PASSWORD=
# ALPHONE_SMTP_FROM=
# Transport security to the relay: mandatory, opportunistic or none.
# ALPHONE_SMTP_TLS=mandatory
# The address email links lead back to, required with a mailer.
# ALPHONE_PUBLIC_URL=
# Directory whose files override the built-in mail templates by name.
# ALPHONE_MAIL_TEMPLATE_DIR=

# How long invite and reset links live, 168h and 1h when unset.
# ALPHONE_INVITE_TTL=168h
# ALPHONE_RESET_TTL=1h
# Reset requests allowed per client IP within one reset link lifetime, 3 when unset.
# ALPHONE_RESET_ATTEMPTS=3
# Reset links that may stand for one account at once, 3 when unset.
# ALPHONE_RESET_LINKS=3
# Shortest gap between two reset mails to one address, 1m when unset.
# ALPHONE_RESET_COOLDOWN=1m

# How long a client has to send a request's headers and the whole request, and how long an idle
# connection waits for its next request, 10s, 30s and 2m when unset.
# ALPHONE_HTTP_READ_HEADER_TIMEOUT=10s
# ALPHONE_HTTP_READ_TIMEOUT=30s
# ALPHONE_HTTP_IDLE_TIMEOUT=2m

# How long a stop gives running requests to finish, how long the ones cancelled after that get to
# end, and how long the plugins get to stop, 10s, 5s and 5s when unset. Whatever stops the server
# must wait longer than the three added together.
# ALPHONE_SHUTDOWN_GRACE=10s
# ALPHONE_SHUTDOWN_CANCEL_GRACE=5s
# ALPHONE_SHUTDOWN_STOP_GRACE=5s

# How long storing the record of one applied account change may take, and how many records
# account:records lists, 5s and 50 when unset.
# ALPHONE_COMMAND_RECORD_TIMEOUT=5s
# ALPHONE_COMMAND_RECORDS_LIMIT=50

# How many days a token minted with token:create lasts when -ttl is left out, 0 for never, 90 when unset.
# ALPHONE_TOKEN_TTL_DAYS=90

# WhatsApp plugin, Meta WhatsApp Cloud API credentials.
ALPHONE_WHATSAPP_VERIFY_TOKEN=
ALPHONE_WHATSAPP_APP_SECRET=
ALPHONE_WHATSAPP_ACCESS_TOKEN=
ALPHONE_WHATSAPP_PHONE_NUMBER_ID=

# Hex encoded 32 byte key sealing per-tenant access tokens at rest.
# ALPHONE_WHATSAPP_CREDENTIALS_KEY=

# Largest inbound attachment stored, in bytes, 26214400 (25 MiB) when unset.
# ALPHONE_WHATSAPP_MEDIA_MAX_BYTES=26214400
# Graph API base URL, https://graph.facebook.com/v23.0 when unset. Only override it for testing.
# ALPHONE_WHATSAPP_GRAPH_URL=

# POEditor sync, one project per text domain.
# POEDITOR_API_TOKEN=
# POEDITOR_PROJECT_ALPHONE=
# POEDITOR_PROJECT_ALPHONE_FIELDS=
# POEDITOR_PROJECT_ALPHONE_IMPORTER=
# POEDITOR_PROJECT_ALPHONE_WHATSAPP=
# Seconds between two uploads to the platform, 60 when unset.
# POEDITOR_UPLOAD_SPACING=60
