type Identity {
  id: UUID!
  email: String!
  name: String!
  role: String!
  capabilities: [String!]!
  grantable: [String!]!
}

type LoginPayload {
  me: Identity!
}

type User {
  id: UUID!
  email: String!
  name: String!
  disabled: Boolean!
  confirmed: Boolean!
  createdAt: DateTime!
  role: String!
}

type InvitePayload {
  delivered: Boolean!
  activationLink: String
}

extend type Query {
  me: Identity! @scope(area: "auth", write: false)
  users: [User!]! @scope(area: "users", write: false)
}

extend type Mutation {
  login(email: String!, password: String!): LoginPayload! @scope(area: "auth", write: true)
  logout: Boolean! @scope(area: "auth", write: true)
  setUserDisabled(id: UUID!, disabled: Boolean!): Boolean! @scope(area: "users", write: true, capability: "manage_users")
  setUserRole(id: UUID!, role: String!): Boolean! @scope(area: "users", write: true, capability: "manage_users")
  invite(email: String!, name: String!, role: String): InvitePayload! @scope(area: "users", write: true, capability: "manage_users")
  resendInvite(email: String!): InvitePayload! @scope(area: "users", write: true, capability: "manage_users")
  acceptInvite(token: String!, password: String!): LoginPayload! @scope(area: "auth", write: true)
  requestPasswordReset(email: String!): Boolean! @scope(area: "auth", write: true)
  resetPassword(token: String!, password: String!): Boolean! @scope(area: "auth", write: true)
}
