type Identity {
  id: UUID!
  email: String!
  name: String!
  role: String!
}

type LoginPayload {
  me: Identity!
}

type User {
  id: UUID!
  email: String!
  name: String!
  disabled: Boolean!
  createdAt: DateTime!
  role: String!
}

extend type Query {
  me: Identity! @scope(area: "auth", write: false)
  users: [User!]! @scope(area: "users", write: false)
}

extend type Mutation {
  login(email: String!, password: String!): LoginPayload! @scope(area: "auth", write: true)
  logout: Boolean! @scope(area: "auth", write: true)
  createUser(email: String!, name: String!, password: String!): User! @scope(area: "users", write: true)
  setUserDisabled(id: UUID!, disabled: Boolean!): Boolean! @scope(area: "users", write: true)
}
