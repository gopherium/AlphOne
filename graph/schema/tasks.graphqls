type Task {
  id: UUID!
  assigneeId: UUID!
  contactId: UUID
  title: String!
  status: String!
  priority: Int!
  dueOn: Date!
  originSource: String
  originEventId: UUID
  createdAt: DateTime!
  contact: Contact @goField(forceResolver: true)
}

type TaskEdge {
  node: Task!
  cursor: String!
}

type TaskConnection {
  edges: [TaskEdge!]!
  pageInfo: PageInfo!
}

extend type Query {
  tasks(date: Date, dueBefore: Date, contactId: UUID, status: String, first: Int, after: String): TaskConnection!
    @scope(area: "tasks", write: false)
  task(id: UUID!): Task @scope(area: "tasks", write: false)
}

input CreateTaskInput {
  title: String!
  dueOn: Date!
  priority: Int
  contactId: UUID
  originEventId: UUID
}

type CreateTaskPayload {
  task: Task!
  replay: Boolean!
}

input UpdateTaskInput {
  title: String
  dueOn: Date
  status: String
  priority: Int
}

extend type Mutation {
  createTask(input: CreateTaskInput!): CreateTaskPayload! @scope(area: "tasks", write: true)
  updateTask(id: UUID!, input: UpdateTaskInput!): Task! @scope(area: "tasks", write: true)
}
