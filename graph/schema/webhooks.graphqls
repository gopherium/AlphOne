type Webhook {
  id: UUID!
  url: String!
  events: [String!]!
  createdAt: DateTime!
}

type CreateWebhookPayload {
  webhook: Webhook!
  secret: String!
}

extend type Query {
  webhooks: [Webhook!]! @scope(area: "webhooks", write: false)
}

extend type Mutation {
  createWebhook(url: String!, events: [String!]!): CreateWebhookPayload!
    @scope(area: "webhooks", write: true)
  deleteWebhook(id: UUID!): Boolean! @scope(area: "webhooks", write: true)
}
