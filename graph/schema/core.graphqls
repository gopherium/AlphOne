directive @goField(
  forceResolver: Boolean
  name: String
  omittable: Boolean
) on FIELD_DEFINITION | INPUT_FIELD_DEFINITION

scalar UUID
scalar DateTime
scalar Date
scalar Upload
scalar JSON

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

type Tenant {
  id: UUID!
  name: String!
}

type Query {
  version: String!
  tenant: Tenant!
}

type Subscription {
  coreEvent: String!
}
